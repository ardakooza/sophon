config {
    agent {
        permission { execute = true }
        security { container = false }
        timing {
            delay = 5
            timeout = 15
            retry { duration = 0 count = 1 }
        }
        input { max-token = 10000 max-bytes = 5242880 }
        output { max-token = 123 }
        connection {
            provider = "openrouter"
            model = "mock/model"
            key = "SOPHON_AUDIT_API_KEY"
        }
    }
}
agent {
    id = 7001
    name = "Audit Agent"
    policy = 7002
}
policy {
    id = 7002
    access { agent }
    action { read = true }
}
